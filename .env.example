# Copy to .env.local and fill in. Public values only (these ship to the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable / anon key>

# Local: http://localhost:8000   Production: your deployed API's https URL
VITE_API_BASE_URL=http://localhost:8000

# Google Analytics 4 measurement ID (Admin -> Data streams -> Web).
# Leave unset and no analytics script loads at all.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
